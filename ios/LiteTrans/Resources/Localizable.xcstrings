    "lan_open_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone on this network who has the address can view, play or preview, and download finished files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一网络中知道此地址的设备可以查看、播放或预览并下载已完成文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一網路中知道此位址的裝置可以查看、播放或預覽並下載已完成檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じネットワークでこのアドレスを知る人は、閲覧、再生またはプレビューができ、完了ファイルをダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크에서 주소를 아는 사람은 조회, 재생 또는 미리보기를 하고 완료된 파일을 다운로드할 수 있습니다."
          }
        }
      }
