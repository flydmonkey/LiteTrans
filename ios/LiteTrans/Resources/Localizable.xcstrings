            "value": "使用條款"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이용약관"
          }
        }
      }
    },
    "privacy_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans processes the files you pick on this device. Source files and converted files stay on your phone or in the folder you choose, and are not uploaded to any server.\n\nThe app does not collect accounts, does not track usage, and does not require a network to convert. Photo and file access is only used to read the videos you select."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans（轻转码）在这台设备上处理你选中的文件。源文件和转出的文件都留在手机或你指定的文件夹里，不会上传到任何服务器。\n\n应用不收集账号、不统计使用行为，也不要求联网才能转码。相册和文件访问只用于读取你选中的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans（輕轉碼）在這台裝置上處理你選中的檔案。來源檔案和轉出的檔案都留在手機或你指定的資料夾裡，不會上傳到任何伺服器。\n\n應用程式不收集帳號、不統計使用行為，也不要求連網才能轉碼。相簿和檔案存取只用來讀取你選中的影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans は、この端末で選んだファイルを処理します。元ファイルと変換後のファイルはスマホまたは指定したフォルダに留まり、サーバーへはアップロードしません。\n\nアカウント収集も利用状況の追跡もなく、変換にネットワークは不要です。写真とファイルへのアクセスは、選んだビデオを読むためだけに使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans는 이 기기에서 고른 파일을 처리합니다. 원본과 변환 파일은 휴대폰이나 지정한 폴더에 남으며 서버로 업로드되지 않습니다.\n\n계정을 수집하지 않고 사용량을 추적하지 않으며, 변환에 네트워크가 필요하지 않습니다. 사진과 파일 접근은 선택한 동영상을 읽는 데만 사용합니다."
          }
        }
      }
    },
