    "about_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans %@\n\nLiteTrans is an on-device conversion tool. Files you pick stay on this device, are not uploaded, and do not require a network. This version is for Xcode devices and TestFlight only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans %@\n\n轻转码。本机转码工具。所选文件只在这台设备上处理，不上传，不要求联网。当前版本仅提供 Xcode 真机与 TestFlight。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans %@\n\n輕轉碼。本機轉碼工具。所選檔案只在這台裝置上處理，不上傳，不要求連網。目前版本僅提供 Xcode 真機與 TestFlight。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans %@\n\nLiteTrans は端末内で変換するツールです。選んだファイルはこの端末に留まり、アップロードせず、変換にネットワークは不要です。このバージョンは Xcode の実機と TestFlight 向けです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteTrans %@\n\nLiteTrans는 기기에서 변환하는 도구입니다. 고른 파일은 이 기기에 남고 업로드되지 않으며, 변환에 네트워크가 필요하지 않습니다. 이 버전은 Xcode 실기기와 TestFlight 전용입니다."
          }
        }
      }
    },
