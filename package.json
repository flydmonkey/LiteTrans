{
  "name": "video-converter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:macos": "tauri build --bundles app,dmg --ci",
    "tauri:build:macos-intel": "tauri build --target x86_64-apple-darwin --bundles app,dmg --ci",
    "tauri:build:windows": "tauri build --bundles nsis --ci",
    "tauri:build:linux": "tauri build --bundles deb,appimage --ci",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch-pdfium": "node scripts/fetch-pdfium.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "postinstall": "node scripts/fetch-ffmpeg.mjs && node scripts/fetch-pdfium.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.6",
    "@tauri-apps/cli": "^2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  }
}
